# Controls what is excluded from the code-deploy ZIP (.gitignore syntax).
# Use !path to force-include. Only this root file is read.

# Secrets and local environment — must never leave the machine.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx

# Virtual environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Tooling / VCS
.git/
.gitignore
.vscode/
.idea/

# Container files are irrelevant on the code-deploy path
Dockerfile
.dockerignore

# Docs and logs add weight without value at runtime
*.md
*.log

# Local eval/telemetry cache
.foundry/results/
.foundry/datasets/
