# Local development only. Copy to `.env` and fill in.
# `.env` is git-ignored. NEVER put an account key or password here — both the
# database and Foundry are reached with DefaultAzureCredential (your `az login`
# identity locally, a managed identity once deployed).

# --- Microsoft Foundry -------------------------------------------------------
# Your EXISTING Foundry project endpoint.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Allow-list of agents this API may address. A client can never reach an agent
# that is not named here, regardless of what it sends in a request body.
AGENT_NAMES=research-agent,triage-agent

# Agents listed here use durable Foundry Responses conversations. Their
# userId -> foundryConversationId link is stored in Cosmos, but their transcript
# remains in Foundry. Agents omitted here use the custom Cosmos transcript path.
FOUNDRY_CONVERSATION_AGENTS=research-agent

# --- Azure Cosmos DB for MongoDB (vCore) -------------------------------------
# Keyless: authMechanism=MONGODB-OIDC means the driver authenticates with a
# Microsoft Entra ID token. No password appears in this string.
MONGO_CONNECTION_STRING=mongodb+srv://<cluster>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=MONGODB-OIDC&retrywrites=false&maxIdleTimeMS=120000
MONGO_DATABASE=agentchat
MONGO_CONVERSATIONS_COLLECTION=conversations
MONGO_MESSAGES_COLLECTION=messages
MONGO_TURNS_COLLECTION=turns

# Local uses DefaultAzureCredential. Set managed_identity in deployed compute;
# optionally set AZURE_MANAGED_IDENTITY_CLIENT_ID for a user-assigned identity.
AZURE_CREDENTIAL_MODE=local

# --- Local POC access ---------------------------------------------------------
# This API has no application-user authentication. It accepts only loopback
# clients and refuses to start on recognized Azure compute. Do not deploy it
# until real caller authentication and authorization are added.
API_POC_MODE=true
API_POC_USER_ID=poc-user

# --- Web ---------------------------------------------------------------------
# Explicit origin allow-list for CORS. The Vite dev server default is below.
CORS_ALLOWED_ORIGINS=http://localhost:5173

API_LOG_LEVEL=INFO
API_MAX_INPUT_CHARS=8000
API_MAX_OUTPUT_CHARS=16000
# Character budget (an approximation, not an exact model-token count).
API_HISTORY_MAX_CHARS=24000
API_HISTORY_MAX_MESSAGES=100
API_REQUEST_TIMEOUT_SECONDS=120
API_TURN_LEASE_SECONDS=180
# Minimal content-free deletion markers expire after one day. Set only to an
# environment-owner-approved period; the application caps this at seven days.
API_DELETION_TOMBSTONE_RETENTION_SECONDS=86400
