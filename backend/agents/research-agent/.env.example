# Local development only. Copy to `.env` and fill in.
# `.env` is git-ignored and excluded from the container build context.
#
# In Foundry these values are supplied by the platform:
#   - FOUNDRY_PROJECT_ENDPOINT is injected automatically (reserved FOUNDRY_* prefix).
#   - AZURE_AI_MODEL_DEPLOYMENT_NAME comes from azure.yaml environmentVariables.
#
# NEVER put an API key or connection string in this file. Authentication uses
# DefaultAzureCredential. If a real secret is ever required, create a Foundry
# project connection and reference it from azure.yaml as
#   ${{connections.<connection-name>.credentials.<field>}}

FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
APP_LOG_LEVEL=INFO
APP_MAX_INPUT_CHARS=8000

# Optional. When set, model calls are routed through the API Management AI
# gateway instead of straight to the Foundry project. This is what produces
# per-user token and cost telemetry. Leave blank to call Foundry directly.
# Must be the https base URL of the gateway API, with no trailing slash.
APP_MODEL_GATEWAY_URL=

# Keeps prompts, completions, function arguments and system instructions out of
# telemetry. Both are required: the first is the Agent Framework switch, the
# second is what the Foundry hosted runtime's own gen_ai instrumentation reads,
# and it captures message content unless explicitly turned off.
ENABLE_SENSITIVE_DATA=false
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
