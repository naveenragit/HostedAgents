# Local development only. Copy to `.env` and fill in.
# `.env` is git-ignored and excluded from the deploy ZIP by `.agentignore`.
#
# In Foundry these values are supplied by the platform:
#   - FOUNDRY_PROJECT_ENDPOINT is injected automatically (reserved FOUNDRY_* prefix).
#   - AZURE_AI_MODEL_DEPLOYMENT_NAME comes from azure.yaml environmentVariables.
#
# NEVER put an API key or connection string in this file. Authentication uses
# DefaultAzureCredential. If a real secret is ever required, create a Foundry
# project connection and reference it from azure.yaml as
#   ${{connections.<connection-name>.credentials.<field>}}

FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
APP_LOG_LEVEL=INFO
APP_MAX_INPUT_CHARS=8000
