# Local development only. Copy to `.env.local` (git-ignored) to override.
# Requests go through the same-origin Vite proxy. Never put secrets, access
# tokens, or other credentials in VITE_* variables; Vite exposes them to the
# browser bundle. The local POC sends no caller identity or authentication data.
VITE_MAX_INPUT_CHARS=8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Production source maps are disabled unless explicitly enabled.
# VITE_BUILD_SOURCEMAP=true
