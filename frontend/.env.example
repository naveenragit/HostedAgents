# Local development only. Copy to `.env.local` (git-ignored) to override.
#
# Requests go to the Vite dev-server proxy on the same origin, so no secrets and
# no cross-origin configuration are needed here.

# Where the dev server forwards /api and /health.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Sent as the `x-dev-user-id` header while the backend runs with AUTH_MODE=dev.
# Change it to see per-user conversation isolation in action.
# Ignored entirely once the backend runs with AUTH_MODE=entra.
VITE_DEV_USER_ID=local-dev-user
