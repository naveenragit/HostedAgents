let rates = datatable(ModelName:string, InputUsdPerMTok:real, CachedInputUsdPerMTok:real, OutputUsdPerMTok:real, RateSource:string) ['gpt-5.4',2.5,0.25,15.0,'billed','gpt-5',1.25,0.125,10.0,'billed','gpt-4.1',2.0,0.2,8.0,'billed','gpt-4o',2.5,2.5,10.0,'billed','text-embedding-3-large',0.13,0.13,0.0,'billed','gpt-5.1',1.25,0.125,20.0,'mixed','gpt-5-mini',0.45,0.045,2.0,'mixed','gpt-5.2',3.5,0.35,28.0,'retail','gpt-5.6-sol',5.0,0.5,30.0,'retail','gpt-5.6-luna',1.0,0.1,6.0,'retail','gpt-5-codex',1.25,0.125,10.0,'retail','gpt-chat-latest',5.0,0.5,30.0,'retail','grok-4',3.0,3.0,15.0,'retail','text-embedding-3-small',0.02,0.02,0.0,'retail']; AppMetrics | where Name in ('Prompt Tokens','Prompt Cached Tokens','Completion Tokens','Completion Reasoning Tokens') | extend d = parse_json(Properties) | where tostring(d['API ID']) == 'hosted-agents-models' | extend UserKey = tostring(d['UserKey']), AgentName = tostring(d['AgentName']), ModelName = tostring(d['ModelName']) | summarize PromptTokens = sumif(Sum, Name == 'Prompt Tokens'), CachedPromptTokens = sumif(Sum, Name == 'Prompt Cached Tokens'), CompletionTokens = sumif(Sum, Name == 'Completion Tokens'), ReasoningTokens = sumif(Sum, Name == 'Completion Reasoning Tokens') by bin(TimeGenerated, 5m), UserKey, AgentName, ModelName | lookup kind=leftouter rates on ModelName | extend PriceKnown = isnotnull(InputUsdPerMTok), RateSource = coalesce(RateSource, 'unpriced') | extend BillableInputTokens = PromptTokens - CachedPromptTokens | extend CacheAdjustedCostUsd = (BillableInputTokens * coalesce(InputUsdPerMTok,0.0) + CachedPromptTokens * coalesce(CachedInputUsdPerMTok,0.0) + CompletionTokens * coalesce(OutputUsdPerMTok,0.0)) / 1000000.0 | extend CacheSavingsUsd = (CachedPromptTokens * (coalesce(InputUsdPerMTok,0.0) - coalesce(CachedInputUsdPerMTok,0.0))) / 1000000.0 | extend TotalTokens = PromptTokens + CompletionTokens | project TimeGenerated, UserKey, AgentName, ModelName, PromptTokens, CachedPromptTokens, BillableInputTokens, CompletionTokens, ReasoningTokens, TotalTokens, CacheAdjustedCostUsd, CacheSavingsUsd, PriceKnown, RateSource