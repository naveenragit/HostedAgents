// Cache-adjusted cost and reasoning-token share, priced from the token metrics
// the gateway emits. ApiManagementGatewayLlmLog carries no cached or reasoning
// column, so these categories exist only here.
//
// Effective-dated rates in USD per 1M tokens, shared with every other pricing
// function via the `ModelRates` saved function. This function used to carry its
// own undated copy, which repriced history on every refresh and drifted from
// the other two because the sync script never named it.
let rates = materialize(ModelRates);
AppMetrics
| where Name in ('Prompt Tokens','Prompt Cached Tokens','Completion Tokens','Completion Reasoning Tokens')
| extend d = parse_json(Properties)
| where tostring(d['API ID']) == 'hosted-agents-models'
| extend
    UserKey   = tostring(d['UserKey']),
    AgentName = tostring(d['AgentName']),
    ModelName = tostring(d['ModelName'])
| summarize
    PromptTokens       = sumif(Sum, Name == 'Prompt Tokens'),
    CachedPromptTokens = sumif(Sum, Name == 'Prompt Cached Tokens'),
    CompletionTokens   = sumif(Sum, Name == 'Completion Tokens'),
    ReasoningTokens    = sumif(Sum, Name == 'Completion Reasoning Tokens')
    by bin(TimeGenerated, 5m), UserKey, AgentName, ModelName
| join kind=leftouter rates on ModelName
// Rank non-applicable rates below a null-rate sentinel rather than filtering
// them out, so a bucket older than its model's first known rate is reported
// unpriced instead of disappearing.
| extend RateApplies = isnotnull(ValidFrom) and ValidFrom <= TimeGenerated
| extend
    RateRank              = iff(RateApplies, ValidFrom, datetime(1800-01-01)),
    InputUsdPerMTok       = iff(RateApplies, InputUsdPerMTok, real(null)),
    CachedInputUsdPerMTok = iff(RateApplies, CachedInputUsdPerMTok, real(null)),
    OutputUsdPerMTok      = iff(RateApplies, OutputUsdPerMTok, real(null)),
    RateSource            = iff(RateApplies, RateSource, '')
| summarize arg_max(RateRank, *) by TimeGenerated, UserKey, AgentName, ModelName
| extend PriceKnown = isnotnull(InputUsdPerMTok)
| extend RateSource = iff(PriceKnown, RateSource, 'unpriced')
| extend BillableInputTokens = PromptTokens - CachedPromptTokens
| extend CacheAdjustedCostUsd = (BillableInputTokens * coalesce(InputUsdPerMTok,0.0) + CachedPromptTokens * coalesce(CachedInputUsdPerMTok,0.0) + CompletionTokens * coalesce(OutputUsdPerMTok,0.0)) / 1000000.0
| extend CacheSavingsUsd = (CachedPromptTokens * (coalesce(InputUsdPerMTok,0.0) - coalesce(CachedInputUsdPerMTok,0.0))) / 1000000.0
| extend TotalTokens = PromptTokens + CompletionTokens
| project TimeGenerated, UserKey, AgentName, ModelName, PromptTokens, CachedPromptTokens, BillableInputTokens, CompletionTokens, ReasoningTokens, TotalTokens, CacheAdjustedCostUsd, CacheSavingsUsd, PriceKnown, RateSource
