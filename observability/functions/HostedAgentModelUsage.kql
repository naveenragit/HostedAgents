// Per-request model usage and cost from the API Management AI gateway.
//
// Two gateway tables are joined on CorrelationId: ApiManagementGatewayLlmLog
// carries the model and token counts but no caller identity, and
// ApiManagementGatewayLogs carries the request headers the user key arrives in.
//
// The gateway subquery is bounded and materialized here on purpose. A saved
// function whose join is filtered from the outside pushes that predicate into
// both branches and silently empties the right-hand side, turning every row
// into 'unattributed'.
let lookback = 30d;
// Effective-dated rates in USD per 1M tokens, shared with every other pricing
// function via the `ModelRates` saved function. Regenerate with
// scripts\sync-model-prices.ps1 and APPEND rows there.
let rates = materialize(ModelRates);
let gw = materialize(
    ApiManagementGatewayLogs
    | where TimeGenerated > ago(lookback)
    | where ApiId == 'hosted-agents-models'
    | extend h = parse_json(RequestHeaders)
    | project
        CorrelationId,
        UserKey   = tostring(h['x-user-key']),
        AgentName = tostring(h['x-agent-name']),
        OperationId,
        ResponseCode,
        IsRequestSuccess,
        TotalTime,
        BackendTime
);
ApiManagementGatewayLlmLog
| where TimeGenerated > ago(lookback)
| join kind=leftouter gw on CorrelationId
| extend
    UserKey   = iff(isempty(UserKey), 'unattributed', UserKey),
    AgentName = iff(isempty(AgentName), 'unknown', AgentName)
| join kind=leftouter rates on ModelName
// A rate that is not yet in effect must neither price the row nor drop it, so
// non-applicable candidates are blanked and ranked below the null-rate sentinel
// instead of being filtered out. Filtering here instead deleted every request
// made before its model's first known rate, understating traffic and cost while
// still reporting a clean 0% unpriced.
| extend RateApplies = isnotnull(ValidFrom) and ValidFrom <= TimeGenerated
| extend
    RateRank              = iff(RateApplies, ValidFrom, datetime(1800-01-01)),
    ValidFrom             = iff(RateApplies, ValidFrom, datetime(null)),
    InputUsdPerMTok       = iff(RateApplies, InputUsdPerMTok, real(null)),
    CachedInputUsdPerMTok = iff(RateApplies, CachedInputUsdPerMTok, real(null)),
    OutputUsdPerMTok      = iff(RateApplies, OutputUsdPerMTok, real(null)),
    RateSource            = iff(RateApplies, RateSource, '')
| summarize arg_max(RateRank, *) by CorrelationId
| extend PriceKnown = isnotnull(InputUsdPerMTok)
| extend RateSource = iff(PriceKnown, RateSource, 'unpriced')
// LlmLog carries no cached-token column, so the input side cannot be discounted
// here. HostedAgentTokenCategories prices cache-adjusted cost from the emitted
// gateway metrics, which do carry it.
| extend EstimatedCostUsd =
    (toreal(PromptTokens)     * coalesce(InputUsdPerMTok, 0.0)
   + toreal(CompletionTokens) * coalesce(OutputUsdPerMTok, 0.0)) / 1000000.0
| project
    TimeGenerated, UserKey, AgentName, ModelName, DeploymentName, Region,
    PromptTokens, CompletionTokens, TotalTokens,
    EstimatedCostUsd, PriceKnown, RateSource, RateValidFrom = ValidFrom,
    IsStreamCompletion, CorrelationId, RequestId, OperationId,
    ResponseCode, IsRequestSuccess, TotalTime, BackendTime
