# ---------------------------------------------------------------------------
# Secrets & local environment  (NEVER commit)
#
# Rules are unanchored, so they apply at every depth: backend/api/.env,
# frontend/.env.local, and so on. Only the *.example templates are tracked.
# Verify with:  git check-ignore -v backend/api/.env
# ---------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!*.env.example

# Local connection details and account identifiers.
secrets/
local.settings.json
secrets.json
appsettings.Development.json
*.pem
*.key
*.pfx
*.p12
*.pubxml
*.publishsettings

# ---------------------------------------------------------------------------
# Azure Developer CLI / Foundry local state
# ---------------------------------------------------------------------------
.azure/
.foundry/results/
.foundry/datasets/
*.azd.env

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/

# Bundled dependency-resolution output for code deploy
packages/

# ---------------------------------------------------------------------------
# Tooling caches / reports
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
.hypothesis/
pip-audit-report.json

# ---------------------------------------------------------------------------
# Packaging artifacts
# ---------------------------------------------------------------------------
*.zip
*.tar.gz

# The deploy script copies the canonical meter map into the function package so
# the zip is self-contained. Tracking the copy would create a second source of
# truth that silently drifts from observability/model-meter-map.json.
backend/functions/billing-sync/billing_sync/model-meter-map.json

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/
